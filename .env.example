# ==============================================================================
# DELAAFRO - Configuration du Chatbot IA "Dela"
# ==============================================================================

# Fournisseur LLM : "gemini" (par défaut) ou "claude"
LLM_PROVIDER=gemini

# Clé API du fournisseur (Google AI Studio pour Gemini, ou Anthropic pour Claude)
# Obtenez une clé Gemini gratuite sur : https://aistudio.google.com/
LLM_API_KEY=YOUR_API_KEY_HERE

# Modèle utilisé (optionnel)
# Gemini : "gemini-1.5-flash" (recommandé), "gemini-2.0-flash", etc.
# Claude : "claude-3-haiku-20240307", "claude-3-5-sonnet-20241022", etc.
LLM_MODEL=gemini-1.5-flash

# Restriction CORS (laisser * en développement local)
ALLOWED_ORIGIN=*
